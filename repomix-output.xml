            if mime_type=="video/mp4":
                return ".mp4"
            elif mime_type=="video/x-m4v":
                return ".m4v"
            elif mime_type=="video/webm":
                return ".webm"
        else:
            return ""

    @staticmethod
    def get_file_mimetype(file_name):
        if file_name:
            if ".mp4" in file_name:
                return "video/mp4"
            elif ".m4v" in file_name:
                return "video/x-m4v"
            elif ".webm" in file_name:
                return "video/webm"
        else:
            return ""


    @staticmethod
    def is_url(text):
        return text.startswith('http://') or text.startswith('https://')

    @staticmethod
    def is_url_image(image_url):
        image_formats = ("image/png", "image/jpeg", "image/jpg")
        r = requests.head(image_url)
        print("Content type:: "+str(r.headers["content-type"]))
        if r.headers["content-type"] in image_formats:
            return True
        return False

    @staticmethod
    def getUrl(request):

        absolute_uri = request.build_absolute_uri()
        full_path = request.get_full_path()

        url = absolute_uri
        cut = absolute_uri.find(full_path)
        if cut > 0:
            url = absolute_uri.replace(full_path,"")

        return url
